# ARI Mobile local development configuration
ENV=dev

# Cloud Run backend. Use either variable; CLOUD_RUN_BACKEND_URL is preferred
# when copying from Google Cloud Run service details.
CLOUD_RUN_BACKEND_URL=https://ari-backend-prod.a.run.app
BACKEND_URL=

# AI provider keys for local/offline fallback only.
# In production, provider secrets should remain in Cloud Run / Secret Manager.
OPENAI_API_KEY=sk-tu_clave_real_aqui
KIMI_API_KEY=
GEMINI_API_KEY=

# PayPal public client id can be used by the app; secret is backend-only.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

FIREBASE_PROJECT=ari-ai-prod
